{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bitácora",
  "version": "0.1.0",
  "identifier": "es.bitacora.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bitácora · Tu trabajo, con perspectiva",
        "width": 1500,
        "height": 980,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#f2f6fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/bitacora-node"],
    "resources": { "resources/service/": "service/" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish"] } }
  }
}
